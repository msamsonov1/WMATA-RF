        function applyFilters() {
            const minRssiCutoff = parseFloat(document.getElementById('min-rssi-slider').value);
            const movingAvgWindow = parseInt(document.getElementById('moving-avg-slider').value);
            const showThreshold = document.getElementById('toggle-threshold').checked;
            const showCmMarkers = document.getElementById('toggle-cm-markers').checked;
            const showStationNames = document.getElementById('toggle-station-names').checked;
            const showPlatformSpans = document.getElementById('toggle-platform-spans').checked;

            filteredData = rawData.filter(r => 
                activeRoutes.has(r.route) &&
                activeChannels.has(r.channelKey) &&
                (activeSegments.size === 0 || activeSegments.has(r.segment)) &&
                r.rssi >= minRssiCutoff
            );

            document.getElementById('record-count-badge').textContent = `${filteredData.length.toLocaleString()} Points`;

            // Group Traces by Frequency Channel
            const traces = [];
            const groupedByChannel = {};

            filteredData.forEach(r => {
                if (!groupedByChannel[r.channelKey]) groupedByChannel[r.channelKey] = [];
                groupedByChannel[r.channelKey].push(r);
            });

            Object.entries(groupedByChannel).forEach(([chKey, points]) => {
                points.sort((a, b) => a.coord - b.coord);
                const info = JURISDICTION_CHANNELS[chKey] || { label: chKey, color: '#6366f1' };

                let coords = points.map(p => p.coord);
                let rssiVals = points.map(p => p.rssi);

                if (movingAvgWindow > 1 && rssiVals.length >= movingAvgWindow) {
                    rssiVals = rssiVals.map((val, idx, arr) => {
                        const start = Math.max(0, idx - Math.floor(movingAvgWindow / 2));
                        const end = Math.min(arr.length, idx + Math.ceil(movingAvgWindow / 2));
                        const sub = arr.slice(start, end);
                        return parseFloat((sub.reduce((a, b) => a + b, 0) / sub.length).toFixed(1));
                    });
                }

                traces.push({
                    x: coords,
                    y: rssiVals,
                    mode: 'lines',
                    name: info.label,
                    line: { color: info.color, width: 2 },
                    hovertemplate: `Coord: %{x} ft (%{customdata})<br>RSSI: %{y} dBm<extra>${info.label}</extra>`,
                    customdata: coords.map(c => formatChainage(c))
                });
            });

            // Calculate Chainage Footage Ticks for X-Axis safely without stack overflow
            let minX = 0;
            let maxX = 6000;
            if (filteredData.length > 0) {
                minX = Infinity;
                maxX = -Infinity;
                for (let i = 0; i < filteredData.length; i++) {
                    const c = filteredData[i].coord;
                    if (c < minX) minX = c;
                    if (c > maxX) maxX = c;
                }
            }
            if (minX === Infinity) minX = 0;
            if (maxX === -Infinity) maxX = 6000;

            const step = Math.max(200, Math.round((maxX - minX) / 10));

            const tickVals = [];
            const tickText = [];
            for (let x = Math.floor(minX / 100) * 100; x <= maxX; x += step) {
                tickVals.push(x);
                tickText.push(`${formatChainage(x)}<br>(${x.toLocaleString()} ft)`);
            }

            const layout = {
                margin: { t: 50, r: 20, l: 60, b: 60 },
                autosize: true,
                xaxis: { 
                    title: 'Chainage Marker Distance (Feet + Footage)', 
                    gridcolor: '#e2e8f0',
                    tickvals: tickVals,
                    ticktext: tickText,
                    zeroline: false
                },
                yaxis: { 
                    title: 'RSSI Signal (dBm)', 
                    range: [-130, -35], // PERMANENT LOCKED Y-AXIS
                    autorange: false,
                    gridcolor: '#e2e8f0',
                    fixedrange: true
                },
                hovermode: 'closest',
                showlegend: true,
                legend: { orientation: 'h', y: -0.22 },
                shapes: [],
                annotations: []
            };

            // Overlay -85 dBm Standard Target Limit Line
            if (showThreshold) {
                layout.shapes.push({
                    type: 'line',
                    x0: 0,
                    x1: 1,
                    xref: 'paper',
                    y0: -85,
                    y1: -85,
                    line: { color: '#ef4444', width: 2, dash: 'dash' }
                });

                layout.annotations.push({
                    x: 0.01,
                    xref: 'paper',
                    y: -83.5,
                    yref: 'y',
                    text: 'STANDARD TARGET LIMIT (-85 dBm)',
                    font: { color: '#ef4444', size: 10, weight: 'bold' },
                    showarrow: false,
                    xanchor: 'left'
                });
            }

            // Identify Station CM Locations and Platform Spans
            const stationMap = {};
            filteredData.forEach(r => {
                if (!stationMap[r.stationCode]) {
                    stationMap[r.stationCode] = {
                        name: getFullStationName(r.stationCode),
                        coords: []
                    };
                }
                stationMap[r.stationCode].coords.push(r.coord);
            });

            Object.entries(stationMap).forEach(([code, st]) => {
                if (st.coords.length === 0) return;
                const cmCoord = st.coords.reduce((a, b) => a + b, 0) / st.coords.length;
                const platStart = cmCoord - 300;
                const platEnd = cmCoord + 300;

                // 1. Platform Greyed-Out Shaded Spans
                if (showPlatformSpans) {
                    layout.shapes.push({
                        type: 'rect',
                        x0: platStart,
                        x1: platEnd,
                        y0: -130,
                        y1: -35,
                        fillcolor: 'rgba(148, 163, 184, 0.20)',
                        line: { color: '#94a3b8', width: 1, dash: 'dot' }
                    });

                    // Annotate Platform Start & End Chain Markers
                    layout.annotations.push({
                        x: platStart,
                        y: -125,
                        text: `Plat Start<br>${formatChainage(platStart)}`,
                        font: { size: 9, color: '#64748b' },
                        showarrow: false,
                        xanchor: 'center'
                    });

                    layout.annotations.push({
                        x: platEnd,
                        y: -125,
                        text: `Plat End<br>${formatChainage(platEnd)}`,
                        font: { size: 9, color: '#64748b' },
                        showarrow: false,
                        xanchor: 'center'
                    });
                }

                // 2. Station CM Vertical Line
                if (showCmMarkers) {
                    layout.shapes.push({
                        type: 'line',
                        x0: cmCoord,
                        x1: cmCoord,
                        y0: -130,
                        y1: -35,
                        line: { color: '#6366f1', width: 1.5, dash: 'dashdot' }
                    });
                }

                // 3. Station Name Labels on Top Header (-38 dBm)
                if (showStationNames) {
                    layout.annotations.push({
                        x: cmCoord,
                        y: -38,
                        text: `<b>${st.name}</b><br><span style="font-size:9px;color:#475569;">CM ${formatChainage(cmCoord)}</span>`,
                        font: { color: '#334155', size: 11 },
                        bgcolor: 'rgba(255, 255, 255, 0.92)',
                        bordercolor: '#cbd5e1',
                        borderwidth: 1,
                        borderpad: 4,
                        showarrow: true,
                        arrowhead: 2,
                        arrowsize: 1,
                        arrowcolor: '#6366f1',
                        ax: 0,
                        ay: -25
                    });
                }
            });

            Plotly.newPlot('plotly-chart', traces, layout, { responsive: true });
            renderStationBreakdownTable();
            renderSectorDiagnosticsTable();
        }

        function renderStationBreakdownTable() {
            const body = document.getElementById('station-breakdown-body');
            if (!body) return;

            const stationGroups = {};
            filteredData.forEach(r => {
                const st = r.stationCm || 'Station Sector';
                if (!stationGroups[st]) stationGroups[st] = [];
                stationGroups[st].push(r.rssi);
            });

            if (Object.keys(stationGroups).length === 0) {
                body.innerHTML = '<tr><td colspan="6" class="p-3 text-center text-slate-400 italic">No telemetry data matching current filters.</td></tr>';
                return;
            }

            body.innerHTML = Object.entries(stationGroups).map(([st, rssis]) => {
                let min = Infinity;
                let max = -Infinity;
                let sum = 0;
                for (let i = 0; i < rssis.length; i++) {
                    const v = rssis[i];
                    sum += v;
                    if (v < min) min = v;
                    if (v > max) max = v;
                }
                const avg = (sum / rssis.length).toFixed(1);
                const minStr = min.toFixed(1);
                const maxStr = max.toFixed(1);
                const passes = rssis.filter(v => v >= -85).length;
                const passRate = ((passes / rssis.length) * 100).toFixed(1);
                const isPass = passRate >= 95;

                return `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-2.5 font-bold text-slate-800">${st}</td>
                        <td class="p-2.5 font-mono text-slate-500">0 - 6,000 ft</td>
                        <td class="p-2.5 font-mono text-slate-600">${rssis.length.toLocaleString()}</td>
                        <td class="p-2.5 font-mono font-semibold ${avg >= -85 ? 'text-emerald-600' : 'text-rose-600'}">${avg} dBm</td>
                        <td class="p-2.5 font-mono text-slate-500">${minStr} / ${maxStr} dBm</td>
                        <td class="p-2.5 font-mono">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${isPass ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                                ${passRate}% (${isPass ? 'PASS' : 'FAIL'})
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

