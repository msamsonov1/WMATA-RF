<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40 shadow-md">
        <div class="max-w-[1800px] mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-indigo-600 p-2 rounded-lg text-white font-bold flex items-center justify-center shadow">
                    <i data-lucide="radio" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-none flex items-center gap-2">
                        Consolidated RF Signal Web Analyzer
                        <span class="text-[10px] bg-indigo-500/30 text-indigo-300 border border-indigo-500/40 px-2 py-0.5 rounded-full font-mono">v4.3 Production</span>
                    </h1>
                    <p class="text-xs text-slate-400 mt-0.5">WMATA Public Safety & Telemetry Coverage Analytics</p>
                </div>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
                <button onclick="openSharePointModal()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-xs font-medium flex items-center gap-1.5 transition shadow-sm">
                    <i data-lucide="folder-git2" class="w-4 h-4 text-sky-400"></i>
                    <span>SharePoint Subfolder Repo</span>
                </button>

                <label class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition shadow">
                    <i data-lucide="folder-up" class="w-4 h-4"></i>
                    <span>Import SharePoint Folder (Subfolders)</span>
                    <input type="file" id="folder-input" webkitdirectory directory multiple onchange="handleFolderUpload(event)" class="hidden">
                </label>

                <button onclick="exportDataCSV()" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-600 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Export CSV Data</span>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-[1800px] w-full mx-auto p-4 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- Sidebar Controls -->
        <aside class="lg:col-span-3 space-y-4">
            
            <!-- Active Dataset Overview -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="database" class="w-4 h-4 text-indigo-600"></i>
                        Active Dataset
                    </h2>
                    <span id="record-count-badge" class="text-[11px] bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded-full border border-indigo-100">0 Points</span>
                </div>
                <p id="dataset-source-label" class="text-xs text-slate-500 truncate font-mono bg-slate-50 p-2 rounded border border-slate-100">PCTEL Visualizer Source Data</p>
                
                <!-- Quick Segment Campaign Select Dropdown -->
                <div class="mt-3">
                    <label class="text-[11px] font-semibold text-slate-600 block mb-1">Select Scan Campaign Segment:</label>
                    <select id="campaign-segment-select" onchange="loadPresetCampaignSegment(this.value)" class="w-full text-xs font-mono bg-slate-50 border border-slate-200 rounded-lg p-1.5 text-slate-700">
                        <optgroup label="A & B Route Scans (May 2026 Scans)">
                            <option value="a01toa02" selected>A01 Metro Center ↔ A02 Farragut North</option>
                            <option value="a08toa09">A08 Friendship Heights ↔ A09 Bethesda</option>
                            <option value="b01tob02">B01 Gallery Place ↔ B02 Judiciary Square</option>
                            <option value="b08tob09">B08 Silver Spring ↔ B09 Forest Glen</option>
                        </optgroup>
                        <optgroup label="C-Route (July 2024 Scans)">
                            <option value="c08toc09">C08 Pentagon City ↔ C09 Crystal City</option>
                            <option value="c09toc10">C09 Crystal City ↔ C10 Reagan Airport</option>
                            <option value="c10toc09">C10 Reagan Airport ↔ C09 Crystal City</option>
                        </optgroup>
                        <optgroup label="E & F Line Scans (June 2026 Scans)">
                            <option value="f01toe01">F01 Gallery Place ↔ E01 Mt Vernon Sq</option>
                            <option value="e03toe04">E03 U Street ↔ E04 Columbia Heights</option>
                            <option value="e07toe06">E07 West Hyattsville ↔ E06 Fort Totten</option>
                            <option value="e08toe09">E08 Hyattsville Crossing ↔ E09 College Park</option>
                            <option value="e09toe10">E09 College Park ↔ E10 Greenbelt</option>
                            <option value="f03toc07">F03 L'Enfant Plaza ↔ C07 Pentagon</option>
                            <option value="f05tof06">F05 Navy Yard ↔ F06 Anacostia</option>
                            <option value="f10tof11">F10 Suitland ↔ F11 Branch Ave</option>
                        </optgroup>
                    </select>
                </div>
            </div>

            <!-- Signal & Display Controls -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 space-y-4">
                <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5 border-b border-slate-100 pb-2">
                    <i data-lucide="sliders" class="w-4 h-4 text-indigo-600"></i>
                    Signal & Display Controls
                </h2>

                <!-- Min RSSI Cutoff Slider -->
                <div>
                    <div class="flex items-center justify-between text-xs mb-1 font-medium text-slate-700">
                        <span>Min RSSI Cutoff:</span>
                        <span id="min-rssi-val" class="font-bold text-indigo-600 font-mono">-120 dBm</span>
                    </div>
                    <input type="range" id="min-rssi-slider" min="-120" max="-30" step="1" value="-120" oninput="updateRangeLabels(); applyFilters();" class="w-full accent-indigo-600 cursor-pointer">
                </div>

                <!-- Moving Average Slider -->
                <div>
                    <div class="flex items-center justify-between text-xs mb-1 font-medium text-slate-700">
                        <span>Chart Moving Average:</span>
                        <span id="moving-avg-val" class="font-bold text-indigo-600 font-mono">1 Point (Raw)</span>
                    </div>
                    <input type="range" id="moving-avg-slider" min="1" max="100" step="1" value="1" oninput="updateRangeLabels(); applyFilters();" class="w-full accent-indigo-600 cursor-pointer">
                </div>

                <!-- Display Toggles -->
                <div class="pt-2 border-t border-slate-100 space-y-2 text-xs">
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 hover:text-indigo-600 transition">
                        <input type="checkbox" id="toggle-threshold" checked onchange="applyFilters()" class="rounded text-indigo-600 accent-indigo-600">
                        <span>Show -85 dBm Standard Limit</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 hover:text-indigo-600 transition">
                        <input type="checkbox" id="toggle-cm-markers" checked onchange="applyFilters()" class="rounded text-indigo-600 accent-indigo-600">
                        <span>Show Station CM Markers</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 hover:text-indigo-600 transition">
                        <input type="checkbox" id="toggle-station-names" checked onchange="applyFilters()" class="rounded text-indigo-600 accent-indigo-600">
                        <span>Show Station Names (Top Header)</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer font-medium text-slate-700 hover:text-indigo-600 transition">
                        <input type="checkbox" id="toggle-platform-spans" checked onchange="applyFilters()" class="rounded text-indigo-600 accent-indigo-600">
                        <span>Show Platform Spans (Grey Regions)</span>
                    </label>
                </div>
            </div>

            <!-- Route Filter Menu -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="git-branch" class="w-4 h-4 text-indigo-600"></i>
                        Metro Route Filter
                    </h2>
                    <div class="flex items-center gap-1">
                        <button onclick="selectAllRoutes(true)" class="text-[10px] text-indigo-600 hover:underline font-semibold">All</button>
                        <span class="text-slate-300 text-[10px]">|</span>
                        <button onclick="selectAllRoutes(false)" class="text-[10px] text-slate-500 hover:underline">Clear</button>
                    </div>
                </div>
                <div id="route-checkboxes" class="grid grid-cols-5 gap-1.5 pt-1">
                    <!-- Populated via JavaScript -->
                </div>
            </div>

            <!-- Frequency & Jurisdiction Checkboxes -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="radio" class="w-4 h-4 text-indigo-600"></i>
                        Jurisdiction Frequencies
                    </h2>
                    <div class="flex items-center gap-1">
                        <button onclick="selectAllChannels(true)" class="text-[10px] text-indigo-600 hover:underline font-semibold">All</button>
                        <span class="text-slate-300 text-[10px]">|</span>
                        <button onclick="selectAllChannels(false)" class="text-[10px] text-slate-500 hover:underline">Clear</button>
                    </div>
                </div>

                <div class="flex items-center gap-1 mb-2 flex-wrap text-[10px]">
                    <button onclick="filterChannelGroup('Core Telemetry')" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded font-medium">Core</button>
                    <button onclick="filterChannelGroup('MARS DL')" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded font-medium">MARS 700</button>
                    <button onclick="filterChannelGroup('VA')" class="px-2 py-0.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded font-medium">Virginia</button>
