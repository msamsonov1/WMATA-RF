            'K01': 'K01 Rosslyn', 'K02': 'K02 Court House', 'K03': 'K03 Clarendon', 'K04': 'K04 Virginia Sq-GMU', 'K05': 'K05 Ballston-MU', 'K06': 'K06 East Falls Church', 'K07': 'K07 West Falls Church', 'K08': 'K08 Dunn Loring', 'K09': 'K09 Vienna'
        };

        let rawData = [];
        let filteredData = [];
        const activeRoutes = new Set(['A', 'B', 'C', 'D', 'E', 'F', 'G', 'J', 'K', 'N']);
        const activeChannels = new Set(Object.keys(JURISDICTION_CHANNELS));
        const activeSegments = new Set();

        function formatChainage(feet) {
            if (isNaN(feet) || feet === null) return '0+00';
            const rounded = Math.round(feet);
            const hundreds = Math.floor(rounded / 100);
            const remainder = Math.abs(rounded % 100);
            const remainderStr = remainder < 10 ? '0' + remainder : '' + remainder;
            return `${hundreds}+${remainderStr}`;
        }

        function getRouteFromSegment(segment) {
            if (!segment) return 'A';
            const clean = segment.trim().toUpperCase();
            const match = clean.match(/([A-Z])\d{1,3}/);
            return match ? match[1] : 'A';
        }

        function getFullStationName(codeOrSegment) {
            if (!codeOrSegment) return 'Metro Station';
            const code = codeOrSegment.toUpperCase().split('TO')[0].replace(/[^A-Z0-9]/g, '');
            return STATION_NAMES[code] || code;
        }

        function normalizeSegmentName(pathOrName) {
            if (!pathOrName) return 'A01toA02';
            let clean = String(pathOrName).trim().toLowerCase();
            
            // Fix common directory typos (e.g. eo4 -> e04, foe -> toe, trailing hyphens)
            clean = clean.replace(/eo(\d+)/g, 'e0$1')
                         .replace(/foe/g, 'toe')
                         .replace(/[^a-z0-9]/g, '');

            const match = clean.match(/([a-z]\d{1,3})to([a-z]\d{1,3})/);
            if (match) {
                return `${match[1].toUpperCase()}to${match[2].toUpperCase()}`;
            }
            return 'A01toA02';
        }

        function detectPctelChannelKey(fileNameOrFreq) {
            const str = String(fileNameOrFreq).toLowerCase();
            
            if (str.includes('490')) return 'crcs_dl_490_78';
            if (str.includes('496') || str.includes('crcs cc') || str.includes('crcs_dl_496')) return 'crcs_dl_496_43';
            if (str.includes('493')) return 'crcs_ul_493_78';
            if (str.includes('499')) return 'crcs_ul_499_51';
            
            if (str.includes('dc psrs') || str.includes('dc_855') || str.includes('dc 800')) return 'dc_855_46';
            if (str.includes('pg psrs') || str.includes('pg_852') || str.includes('pg rs')) return 'pg_852_90';
            if (str.includes('wmata mars') || str.includes('774') || str.includes('mars')) return 'mars_773_76';
            if (str.includes('arl') || str.includes('arlington')) return 'ar_859_43';
            if (str.includes('alex') || str.includes('856_83')) return 'al_856_83';
            if (str.includes('fairfax') || str.includes('fx_856')) return 'fx_856_26';
            if (str.includes('loudoun') || str.includes('ld_853')) return 'ld_853_05';
            if (str.includes('moco') || str.includes('montgomery')) return 'mc_853_68';

            return 'crcs_dl_496_43';
        }

        function extractNumericValue(row, keySubstrings, defaultValue) {
            if (!row || typeof row !== 'object') return defaultValue;
            const entries = Object.entries(row);
            
            for (const search of keySubstrings) {
                for (const [key, val] of entries) {
                    if (key.toLowerCase().trim().includes(search)) {
                        if (val !== null && val !== undefined && val !== '') {
                            const parsed = parseFloat(String(val).replace(/[^0-9.-]/g, ''));
                            if (!isNaN(parsed)) return parsed;
                        }
                    }
                }
            }
            return defaultValue;
        }

        function renderRouteCheckboxes() {
            const container = document.getElementById('route-checkboxes');
            if (!container) return;
            const routes = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'J', 'K', 'N'];
            container.innerHTML = routes.map(r => `
                <button onclick="toggleRoute('${r}')" class="px-2 py-1 rounded text-xs font-bold font-mono transition ${
                    activeRoutes.has(r) ? 'bg-indigo-600 text-white shadow-sm' : 'bg-slate-100 text-slate-500 hover:bg-slate-200'
                }">${r}</button>
            `).join('');
        }

        function toggleRoute(r) {
            if (activeRoutes.has(r)) activeRoutes.delete(r);
            else activeRoutes.add(r);
            renderRouteCheckboxes();
            renderSegmentCheckboxes();
            applyFilters();
        }

        function selectAllRoutes(select) {
            const routes = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'J', 'K', 'N'];
            routes.forEach(r => select ? activeRoutes.add(r) : activeRoutes.delete(r));
