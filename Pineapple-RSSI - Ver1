                                <th class="p-2.5 text-center">PG DL 852.9000</th>
                                <th class="p-2.5 text-center">MARS DL 773.76875</th>
                            </tr>
                        </thead>
                        <tbody id="sector-diagnostics-body" class="divide-y divide-slate-100 font-mono text-[11px]">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

        </section>
    </main>

    <!-- SharePoint Subfolder Modal -->
