        function renderSegmentCheckboxes() {
            const container = document.getElementById('segment-checkboxes');
            if (!container) return;
            container.innerHTML = '';

            const availableSegments = [...new Set(rawData.map(r => r.segment))];
            const filteredSegments = availableSegments.filter(seg => activeRoutes.has(getRouteFromSegment(seg)));

