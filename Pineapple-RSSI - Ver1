                <div id="channel-checkboxes" class="space-y-3 max-h-72 overflow-y-auto custom-scrollbar pr-1">
                    <!-- Populated via JavaScript -->
                </div>
            </div>

            <!-- Inter-Station Segment Log Checkboxes -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="layers" class="w-4 h-4 text-indigo-600"></i>
                        Inter-Station Segments
                    </h2>
                    <div class="flex items-center gap-1">
                        <button onclick="selectAllSegments(true)" class="text-[10px] text-indigo-600 hover:underline font-semibold">All</button>
                        <span class="text-slate-300 text-[10px]">|</span>
                        <button onclick="selectAllSegments(false)" class="text-[10px] text-slate-500 hover:underline">Clear</button>
                    </div>
                </div>

                <div id="segment-checkboxes" class="space-y-1 max-h-60 overflow-y-auto custom-scrollbar pr-1 text-xs">
                    <!-- Populated via JavaScript -->
                </div>
            </div>

        </aside>

        <section class="lg:col-span-9 space-y-5">

            <!-- Interactive Plotly Canvas -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200 flex flex-col">
                <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
                    <div>
                        <h2 id="chart-banner-title" class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <span>RF Coverage Signal Strength Profile</span>
                            <span id="active-segment-tag" class="text-xs bg-indigo-100 text-indigo-800 font-mono px-2 py-0.5 rounded">A01 Metro Center ↔ A02 Farragut North</span>
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Distance vs. RSSI Telemetry across active jurisdiction channels</p>
                    </div>
                    <div class="flex items-center gap-3 text-xs font-mono">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Pass: ≥ -85 dBm</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Fail: &lt; -85 dBm</span>
                    </div>
                </div>

                <div id="plotly-chart" class="w-full h-[520px]"></div>
            </div>

            <!-- Station-by-Station Coverage Summary Table -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                        <i data-lucide="table" class="w-4 h-4 text-indigo-600"></i>
                        Station CM Coverage Breakdown
                    </h2>
                    <span class="text-xs text-slate-500">Filtered Telemetry Aggregation</span>
                </div>

                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-100 text-slate-600 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-200">
                                <th class="p-2.5">Station CM Name</th>
                                <th class="p-2.5">CM Marker Range</th>
                                <th class="p-2.5">Point Count</th>
                                <th class="p-2.5">Avg RSSI</th>
                                <th class="p-2.5">Min / Max RSSI</th>
                                <th class="p-2.5">Pass Rate (≥ -85 dBm)</th>
                            </tr>
                        </thead>
                        <tbody id="station-breakdown-body" class="divide-y divide-slate-100">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sector Diagnostics Table -->
            <div class="bg-white rounded-xl p-4 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
                    <div>
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i data-lucide="cpu" class="w-4 h-4 text-indigo-600"></i>
                            Sector Diagnostics & RF Amp Inventory
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Target Limits: ≥ -85 dBm across station platform spans and inter-station tunnel sectors</p>
                    </div>
                    <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg border border-slate-200 font-semibold">WMATA Station Sectors</span>
                </div>

                <div class="overflow-x-auto max-h-96 custom-scrollbar">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="sticky top-0 bg-slate-900 text-white text-[10px] uppercase tracking-wider font-semibold shadow">
                            <tr>
                                <th class="p-2.5 min-w-[180px]">Station / Jurisdiction</th>
                                <th class="p-2.5">Platform ID</th>
                                <th class="p-2.5">Span (Feet)</th>
