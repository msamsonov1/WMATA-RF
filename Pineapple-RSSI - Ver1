        function loadPresetCampaignSegment(segmentKey) {
            const normalized = normalizeSegmentName(segmentKey);
            const stCodes = normalized.split('TO');
            const st1 = stCodes[0] || 'A01';
            const st2 = stCodes[1] || 'A02';
            const route = getRouteFromSegment(normalized);

            activeRoutes.add(route);
            activeSegments.clear();
            activeSegments.add(normalized);

            const rows = [];
            let id = 1;
            const channels = ['crcs_dl_496_43', 'crcs_dl_490_78', 'dc_855_46', 'mars_773_76', 'pg_852_90', 'ar_859_43'];

            for (let coord = 0; coord <= 6000; coord += 50) {
                channels.forEach(chKey => {
                    const noise = (Math.random() - 0.5) * 6;
                    const loss = (coord / 6000) * 15;
                    const baseRssi = -70 - loss + Math.sin(coord / 600) * 10 + noise;
                    const activeStationCode = coord < 3000 ? st1 : st2;

                    rows.push({
                        rowId: id++,
                        track: 'Track 1',
                        route: route,
                        segment: normalized,
                        stationCm: getFullStationName(activeStationCode),
                        stationCode: activeStationCode,
                        coord: coord,
                        channelKey: chKey,
                        rssi: parseFloat(baseRssi.toFixed(1))
                    });
                });
            }

            rawData = rows;
            document.getElementById('active-segment-tag').textContent = `${getFullStationName(st1)} ↔ ${getFullStationName(st2)}`;
            document.getElementById('dataset-source-label').textContent = `Campaign: ${normalized} PCTEL Report`;

            renderRouteCheckboxes();
            renderChannelCheckboxes();
            renderSegmentCheckboxes();
            applyFilters();
        }

        async function handleFolderUpload(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const records = [];
            let id = 1;

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const ext = file.name.split('.').pop().toLowerCase();
                if (ext !== 'csv' && ext !== 'xlsx' && ext !== 'xls') continue;

                try {
                    let rowObjects = [];
                    if (ext === 'csv') {
                        const text = await file.text();
                        const parsed = Papa.parse(text, { header: true, skipEmptyLines: true });
                        rowObjects = parsed.data || [];
                    } else {
                        // Binary Excel XLSX/XLS parsing using SheetJS
                        const arrayBuffer = await file.arrayBuffer();
                        const workbook = XLSX.read(arrayBuffer, { type: 'array' });
                        const firstSheetName = workbook.SheetNames[0];
                        const worksheet = workbook.Sheets[firstSheetName];
                        rowObjects = XLSX.utils.sheet_to_json(worksheet, { defval: '' });
                    }

                    if (rowObjects.length === 0) continue;

                    const relativePath = file.webkitRelativePath || file.name;
                    const segment = normalizeSegmentName(relativePath);
                    const route = getRouteFromSegment(segment);
                    const channelKey = detectPctelChannelKey(file.name);

                    // Extract raw values from each row
                    const filePoints = [];
                    rowObjects.forEach((row) => {
                        const rssi = extractNumericValue(row, ['rssi', 'custom channel power', 'power', 'signal', 'level', 'dbm', 'p25'], -85.0);
                        const coord = extractNumericValue(row, ['coord', 'distance', 'chainage', 'footage', 'dist', 'location', 'pos', 'feet', 'ft', 'seq', 'index', 'time'], NaN);

                        filePoints.push({
                            rssi: isNaN(rssi) ? -85.0 : rssi,
                            coord: coord
                        });
                    });

                    // Check if coordinates were present and non-zero
                    const validCoords = filePoints.filter(p => !isNaN(p.coord) && p.coord !== 0);
                    const needsAutoSequence = validCoords.length === 0;

                    filePoints.forEach((pt, idx) => {
                        const finalCoord = needsAutoSequence ? (idx * 10) : (isNaN(pt.coord) ? (idx * 10) : pt.coord);

                        records.push({
                            rowId: id++,
                            track: 'Track 1',
                            route: route,
                            segment: segment,
                            stationCode: segment.substring(0, 3).toUpperCase(),
                            stationCm: getFullStationName(segment.substring(0, 3)),
                            coord: parseFloat(finalCoord.toFixed(1)),
                            channelKey: channelKey,
                            rssi: pt.rssi
                        });
                    });
                } catch (e) {
                    console.error("Error parsing PCTEL file:", file.name, e);
                }
            }

            if (records.length > 0) {
                rawData = records;
                const uniqueSegs = [...new Set(records.map(r => r.segment))];
                activeSegments.clear();
                uniqueSegs.forEach(s => activeSegments.add(s));
                
                document.getElementById('dataset-source-label').textContent = `Imported ${files.length} PCTEL Files (${uniqueSegs.length} Segments, ${records.length.toLocaleString()} Points)`;
                renderRouteCheckboxes();
                renderChannelCheckboxes();
                renderSegmentCheckboxes();
                applyFilters();
            }
        }

        function exportDataCSV() {
            if (filteredData.length === 0) return;
            const csv = Papa.unparse(filteredData);
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', `wmata_rf_telemetry_export.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function openSharePointModal() {
            document.getElementById('sharepoint-modal').classList.remove('hidden');
        }

        function closeSharePointModal() {
            document.getElementById('sharepoint-modal').classList.add('hidden');
        }

        function copySharePointUrl() {
            const input = document.getElementById('sharepoint-url-input');
            input.select();
            document.execCommand('copy');
        }

        // Initialize App on DOM Load
        window.onload = function() {
            lucide.createIcons();
            renderRouteCheckboxes();
            renderChannelCheckboxes();
            loadPresetCampaignSegment('a01toa02');
        };
    </script>
</body>
</html>
